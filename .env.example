# Shared between cloud and edge for the MVP.
EDGE_TOKEN=replace-with-a-long-random-edge-token

# Cloud service
CONTROL_API_TOKEN=replace-with-a-long-random-api-token
CLOUD_ADDR=:8080
COMMAND_TIMEOUT=6s

# Edge agent
DEVICE_ID=rv-001
CLOUD_GRPC_ADDR=localhost:8080
CLOUD_INSECURE=true
CLOUD_SERVER_NAME=
BLE_GATEWAY_ADDR=127.0.0.1:50051
EDGE_COMMAND_TIMEOUT=4s
HEARTBEAT_INTERVAL=15s
